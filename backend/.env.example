PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Pooler
DATABASE_URL=postgresql://postgres.USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (Optional, falls back to local storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Zoho ZeptoMail (Optional, falls back to console logging if empty)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_SENDER_EMAIL=noreply@annauniv.edu
ZEPTOMAIL_SENDER_NAME=College Grievance Redressal
